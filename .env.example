# Number of concurrent worker containers (each handles one question at a time)
WORKER_COUNT=4

# Supabase — all bot credentials (tokens, signing secrets, admin users) live in the bots table
# Also used by `make db-migrate` (Flyway) to apply src/migrations/
SUPABASE_DB_URL='postgresql://...'

# ngrok auth token — free at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_token

# OpenAI — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Router model used for skill selection (optional — defaults to gpt-4o-mini)
# ROUTER_MODEL=gpt-4o-mini

# Databricks — host is your workspace URL, e.g. https://adb-1234567890.12.azuredatabricks.net
# Warehouse ID is found in SQL Warehouses > your warehouse > Connection details
# Access token: User settings > Developer > Access tokens > Generate new token
DATABRICKS_HOST=https://adb-xxxxxxxxxxxx.xx.azuredatabricks.net
DATABRICKS_WAREHOUSE_ID=xxxxxxxxxxxxxxxx
DATABRICKS_ACCESS_TOKEN=dapixxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub PAT (fine-grained, contents:write + pull_requests:write) scoped to
# VireoAI/vireox-data-platform — used to open access-control PRs on request approval
GIT_REPO_PAT_DATA_PLATFORM=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Fernet key encrypting cached service-principal secrets at rest in Supabase.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# Public base URL of the receiver (ngrok URL in dev, real domain in prod) — used to build
# the one-time secret-view link posted to Slack, e.g. https://your-domain.example
SECRET_LINK_BASE_URL=
